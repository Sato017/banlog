# 复制为 .env 后使用：
# Copy this file to .env before running Prisma.
DATABASE_URL="file:./dev.db"

# 可选。默认使用官方 AniList GraphQL：
# ANILIST_API_URL="https://graphql.anilist.co"

# 可选。中文标题映射文件；默认自动查找 data/anilist-chinese.json。
# BANLOG_CHINESE_MAP_PATH="data/anilist-chinese.json"

# 可选。翻译接口；默认 Google 免费端点，可换成兼容代理。
# TRANSLATE_API_URL="https://translate.googleapis.com/translate_a/single"
